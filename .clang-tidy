# The style CI keeps (the "Alpine x86_64 (clang++)" job): nullptr, no else
# after return, unused parameters unnamed.  Run as CI does with
#   clang-tidy -p <build directory> file.cpp
# on a build configured with -DCMAKE_EXPORT_COMPILE_COMMANDS=ON.
Checks: '-*,modernize-use-nullptr,readability-else-after-return,misc-unused-parameters'
WarningsAsErrors: '*'
# The tree's own headers, not generated ones, nor gif.h, which is not ours
HeaderFilterRegex: 'tdlib-purple/(test/)?[A-Za-z0-9_-]+\.h$'
ExcludeHeaderFilterRegex: 'gif\.h$'
