msgstr "Dërgoje si foto"

#. TRANSLATOR: Item of the menu of a pasted thing's placeholder, such as [Image#1] or [report.pdf#3], in the message being written.
#: ../tdlib-purple.cpp:1071
msgid "Remove from the message"
msgstr "Hiqe nga mesazhi"

#. TRANSLATOR: Error after the /paste command.
#: ../tdlib-purple.cpp:1096 ../tdlib-purple.cpp:1113
msgid "There are no files or picture on the clipboard."
msgstr "Nuk ka skedarë apo foto në kujtesën e fragmenteve."

#. TRANSLATOR: In-chat notification, of a picture or video pasted, in the list after "Pasted". The arguments are its placeholders, the second by a file name, such as [Image#1] and [holiday.jpg#1].
#: ../tdlib-purple.cpp:1122
#, c++-format
msgid "{0} (or {1}, as a file)"
msgstr "{0} (ose {1}, si skedar)"

#. TRANSLATOR: In-chat notification, not logged, after /paste. The argument is the pasted things' placeholders, such as [Image#1] or [report.pdf].
#: ../tdlib-purple.cpp:1126
#, c++-format
msgid "Pasted {}: write it into the message, where it goes, to send it there."
msgstr "U ngjit {}: shkruajeni në mesazh, aty ku duhet, për ta dërguar atje."

#. TRANSLATOR: Error dialog, secondary content. Argument is the account's name, its phone number.
#: ../tdlib-purple.cpp:1269
#, c++-format
msgid "Account {} is not connected."
msgstr "Llogaria {} s’është e lidhur."

#. TRANSLATOR: Error dialog, primary content, after a file's link in a conversation was clicked.
#: ../tdlib-purple.cpp:1271
msgid "Cannot open the file"
msgstr "Kartela s’mund të hapet"

#. TRANSLATOR: Information dialog, after a link to a message in a conversation was clicked. Primary content.
#: ../tdlib-purple.cpp:1314
msgid "The message is not shown"
msgstr "Mesazhi nuk shfaqet"

#. TRANSLATOR: Information dialog, secondary content.
#: ../tdlib-purple.cpp:1316
msgid "It is no longer in this conversation's window."
msgstr "Nuk ndodhet më në dritaren e kësaj bisede."

#. TRANSLATOR: Command description, the initial "kick <user>" must remain verbatim!
#: ../tdlib-purple.cpp:1528
msgid "kick <user>: Kick a user from the room using name or internal id"
msgstr ""
"kick <përdorues>: Përzini nga dhoma një përdorues duke përdorur emrin ose ID "
"të brendshme"

#. TRANSLATOR: Command description, the initial "hangup" must remain verbatim!
#: ../tdlib-purple.cpp:1534
msgid "hangup: Terminate any active call (with any user)"
msgstr "hangup: Përfundoni çfarëdo thirrjeje aktive (me cilindo përdorues)"

#. TRANSLATOR: Command description, the initial "cancel" must remain verbatim!
#: ../tdlib-purple.cpp:1540
msgid "cancel: Leave the message being edited as it was"
msgstr "cancel: Lëre mesazhin që po ndryshohet siç ishte"

#. TRANSLATOR: Command description, the initial "paste" must remain verbatim!
#: ../tdlib-purple.cpp:1546
msgid ""
"paste: Attach the files copied to the clipboard, or its picture, to the "
"message being written"
msgstr ""
"paste: Bashkëngjit te mesazhi që po shkruhet skedarët e kopjuar në kujtesën "
"e fragmenteve, ose foton e saj"

#. TRANSLATOR: Tdlib crash dialog, secondary content. Argument is a filesystem path. Please keep the space after it!
#: ../tdlib-purple.cpp:1566
#, c++-format
msgid ""
"The error may be caused by corrupt account data. If this is the case, it "
"could be fixed by removing account data under {} . You will be required to "
"log in into the account again."
msgstr ""
"Gabimi mund të jetë shkarkuar nga të dhëna të dëmtuara llogarie. Nëse është "
"kështu, mund të ndreqej duke hequr të dhënat e llogarisë nën {} . Do t’ju "
"kërkohet të hyni në llogari sërish."

#. TRANSLATOR: Tdlib crash dialog, title
#: ../tdlib-purple.cpp:1576
msgid "Fatal error encountered in telegram plugin"
msgstr "U has gabim fatal te shtojca Telegram"

#. TRANSLATOR: Account settings, value for file downloads (hyperlink link file:///tmp/asdf)
#: ../tdlib-purple.cpp:1693 ../tdlib-purple.cpp:1698
msgid "Inline (hyperlinks in chat)"
msgstr "Brendazi (tejlidhje brenda fjalosjesh)"

#. TRANSLATOR: Account settings, value for file downloads (file transfer dialog)
#: ../tdlib-purple.cpp:1695 ../tdlib-purple.cpp:1697
msgid "Standard file transfers"
msgstr "Shpërngulje standarde kartelash"

#. TRANSLATOR: Account settings, key (choice)
#: ../tdlib-purple.cpp:1702
msgid "File downloads"
msgstr "Shkarkime kartelash"

#. TRANSLATOR: Account settings, key (choice)
#: ../tdlib-purple.cpp:1707
msgid "Inline auto-download size limit, MB (0 for unlimited)"
msgstr "Kufi madhësie vetëshkarkimi të brendshëm, MB (0 për të pakufizuar)"

#. TRANSLATOR: Account settings, value for "Prefetch videos"; "the auto-download limit" is the option "Inline auto-download size limit".
#: ../tdlib-purple.cpp:1716
msgid "Highest resolution within the auto-download limit (if one is set)"
msgstr ""
"Qartësia më e lartë brenda kufirit të vetëshkarkimit (nëse është caktuar)"

#. TRANSLATOR: Account settings, value for "Prefetch videos": the highest resolution, or nothing if that is above the auto-download limit.
#: ../tdlib-purple.cpp:1719
msgid "Highest resolution only"
msgstr "Vetëm qartësia më e lartë"

#. TRANSLATOR: Account settings, value for "Prefetch videos"
#: ../tdlib-purple.cpp:1721
msgid "Smallest file"
msgstr "Kartela më e vogël"

#. TRANSLATOR: Account settings, value for "Prefetch videos"
#: ../tdlib-purple.cpp:1723
msgid "Don't prefetch"
msgstr "Mos i shkarko paraprakisht"

#. TRANSLATOR: Account settings, key (choice). Videos are downloaded beforehand, so that they play as soon as clicked.
#: ../tdlib-purple.cpp:1725
msgid "Prefetch videos"
msgstr "Shkarko paraprakisht videot"

#. TRANSLATOR: Account settings, value for large file downloads
#: ../tdlib-purple.cpp:1732
msgid "Ask"
msgstr "Pyet"

#. TRANSLATOR: Account settings, value for large file downloads
#: ../tdlib-purple.cpp:1734
msgid "Discard"
msgstr "Hidhe Tej"

#. TRANSLATOR: Account settings, check box label
#: ../tdlib-purple.cpp:1737
msgid "Do not clean up inline downloads"
msgstr "Mos spastro shkarkime brendazi"

#. TRANSLATOR: Account settings, key (choice)
#: ../tdlib-purple.cpp:1743
msgid "Bigger inline file downloads"
msgstr "Shkarkime më të mëdha kartelash brendazi"

#. TRANSLATOR: Account settings, key (boolean). The password is the one of the account's settings, not Telegram's two-step verification password.
#: ../tdlib-purple.cpp:1747
msgid ""
"Encrypt the local database with the password (takes effect at reconnect)"
msgstr ""
"Fshehtëzoje bazën vendore të të dhënave me fjalëkalimin (hyn në fuqi pas "
"rilidhjes)"

#. TRANSLATOR: Account settings, key (boolean)
#: ../tdlib-purple.cpp:1752
msgid "Enable secret chats (takes effect at reconnect)"
msgstr "Aktivizo fjalosje të fshehta (hyn në fuqi pas rilidhjes)"

#. TRANSLATOR: Account settings, key (boolean)
#: ../tdlib-purple.cpp:1759
msgid "Show animated stickers"
msgstr "Shfaq ngjitës të animuar"

#. TRANSLATOR: Account settings, key (boolean)
#: ../tdlib-purple.cpp:1765
msgid "Show self-destructing messages anyway"
msgstr "Shfaq sido qoftë mesazhe të vetëasgjësueshëm"

#. TRANSLATOR: Account settings, key (boolean)
#: ../tdlib-purple.cpp:1770
msgid "Strike out deleted messages in Pidgin, rather than remove them"
msgstr "Vija mbi mesazhet e fshira në Pidgin, në vend që t'i hiqni"

#. TRANSLATOR: Account settings, key (boolean)
#: ../tdlib-purple.cpp:1775
msgid "Show messages from channels and groups you have not joined"
msgstr "Shfaq mesazhe nga kanale dhe grupe ku s’jeni bërë pjesë"

#. TRANSLATOR: Account settings, key (boolean). Of a file sent by file transfer ("Send File..."): told by its content, as a pasted one is; otherwise it goes as a file.
#: ../tdlib-purple.cpp:1781
msgid "Send a file as a picture, video or voice message when it is one"
msgstr "Dërgoje një skedar si foto, video apo mesazh zanor, kur është i tillë"

#. TRANSLATOR: Account settings, key (boolean). Custom emoji are pictures of their own, each standing for an ordinary emoji.
#: ../tdlib-purple.cpp:1787
msgid "Show custom emoji in reactions as ordinary emoji"
msgstr "Shfaqi emoji-t vetjake te reagimet si emoji të zakonshme"

#. TRANSLATOR: 2FA settings, key
#: ../tdlib-purple.cpp:1808
msgid "Current password"
msgstr "Fjalëkalimi i tanishëm"

#. TRANSLATOR: 2FA settings, key
#. TRANSLATOR: Database password dialog, key
#: ../tdlib-purple.cpp:1813 ../tdlib-purple.cpp:1914
msgid "New password"
msgstr "Fjalëkalim i ri"

#. TRANSLATOR: 2FA settings, key
#: ../tdlib-purple.cpp:1818
msgid "Repeat password"
msgstr "Përsëritni fjalëkalimin"

#. TRANSLATOR: 2FA settings, key
#: ../tdlib-purple.cpp:1823
msgid "Password hint"
msgstr "Ndihmëz fjalëkalimi"

#. TRANSLATOR: 2FA settings, key
#: ../tdlib-purple.cpp:1827
msgid "Recovery e-mail"
msgstr "Email rimarrjesh"

#. TRANSLATOR: 2FA settings, primary content (after mistype)
#. TRANSLATOR: Database password dialog, primary content (after mistype)
#: ../tdlib-purple.cpp:1848 ../tdlib-purple.cpp:1890
msgid "Please enter same password twice"
msgstr "Ju lutemi, jepeni fjalëkalimin dy herë"

#. TRANSLATOR: 2FA settings, primary content
#: ../tdlib-purple.cpp:1879
msgid "Enter new password and recovery e-mail address"
msgstr "Jepni fjalëkalim të ri dhe adresë email rimarrjesh"

#. TRANSLATOR: Database password dialog, key
#: ../tdlib-purple.cpp:1918
msgid "Confirm password"
msgstr "Ripohoni fjalëkalimin"

#. TRANSLATOR: Database password dialog, secondary content
#: ../tdlib-purple.cpp:1926
msgid ""
"The local database is encrypted with the new password, which becomes the "
"account's."
msgstr ""
"Baza vendore e të dhënave është e fshehtëzuar me fjalëkalimin e ri, i cili "
"bëhet fjalëkalimi i llogarisë."

#. TRANSLATOR: Database password dialog, primary content
#: ../tdlib-purple.cpp:1941
msgid "Change the local database's password"
msgstr "Ndryshoni fjalëkalimin e bazës vendore të të dhënave"

#. TRANSLATOR: 2FA settings, title
#: ../tdlib-purple.cpp:1950
msgid "Configure two-factor authentication..."
msgstr "Formësoni mirëfilltësim dyfaktorësh…"

#. TRANSLATOR: Account action, opening the dialog of the database's password
#: ../tdlib-purple.cpp:1954
msgid "Change the database password..."
msgstr "Ndryshoni fjalëkalimin e bazës së të dhënave..."

