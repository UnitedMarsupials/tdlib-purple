msgstr "Prosím vložte dvakrát stejné heslo"

#. TRANSLATOR: 2FA settings, primary content
#: ../tdlib-purple.cpp:1961
msgid "Enter new password and recovery e-mail address"
msgstr "Zadejte heslo a e-mail pro obnovení"

