msgid "Repeat password"
msgstr "Potvrdit heslo"

#. TRANSLATOR: 2FA settings, key
#: ../tdlib-purple.cpp:1905
msgid "Password hint"
msgstr "Nápověda k heslu"

#. TRANSLATOR: 2FA settings, key
#: ../tdlib-purple.cpp:1909
msgid "Recovery e-mail"
msgstr "E-mail k obnovení"

#. TRANSLATOR: 2FA settings, primary content (after mistype)
#. TRANSLATOR: Database password dialog, primary content (after mistype)
#: ../tdlib-purple.cpp:1930 ../tdlib-purple.cpp:1972
