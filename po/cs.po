#: ../tdlib-purple.cpp:2000
msgid "Confirm password"
msgstr "Potvrzení hesla"

#. TRANSLATOR: Database password dialog, secondary content
#: ../tdlib-purple.cpp:2008
msgid ""
"The local database is encrypted with the new password, which becomes the "
"account's."
msgstr ""
"Místní databáze je zašifrována novým heslem, které se stává heslem účtu."

#. TRANSLATOR: Database password dialog, primary content
#: ../tdlib-purple.cpp:2023
msgid "Change the local database's password"
msgstr "Změnit heslo místní databáze"

