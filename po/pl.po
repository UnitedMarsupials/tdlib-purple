#. TRANSLATOR: Dialog title of an error message.
#. TRANSLATOR: Dialog title, asking about an incoming telephone call (OK/Cancel)
#: ../call.cpp:29 ../call.cpp:216
msgid "Voice call"
msgstr "Rozmowa głosowa"

#. TRANSLATOR: Dialog content of an error message.
#: ../call.cpp:31
msgid "Cannot start new call, already in another call"
msgstr "Nie można rozpocząć nowej rozmowy, trwa inna rozmowa"

#. For an outgoing call, "type /hangup to terminate" has already been shown when the call
#. was initiated
#. TRANSLATOR: In-chat status message
#: ../call.cpp:139
msgid "Call active"
msgstr "Rozmowa jest aktywna"

#. TRANSLATOR: In-chat status message. Please keep '/hangup' verbatim!
#: ../call.cpp:141
msgid "Call active, type /hangup to terminate"
msgstr "Rozmowa jest aktywna, wpisanie /hangup ją zakończy"

#. TRANSLATOR: In-chat error message, argument is text
#: ../call.cpp:170
#, c++-format
msgid "Call failed: {}"
msgstr "Rozmowa się nie powiodła: {}"

#. TRANSLATOR: In-chat error message
#: ../call.cpp:194
msgid "Received incoming call, but calls are not supported"
msgstr "Odebrano rozmowę przychodzącą, ale rozmowy nie są obsługiwane"

#. TRANSLATOR: Dialog content, user will have the options "_OK" and "_Cancel".
#: ../call.cpp:208
#, c++-format
msgid "{} wishes to start a call with you."
msgstr "{} chce rozpocząć rozmowę."

#. TRANSLATOR: Dialog option, regarding a phone call; the alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Authentication dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Registration dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Paid reaction dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Message editing dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA setup confirmation dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Group creation dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA settings, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#: ../call.cpp:220 ../td-client.cpp:629 ../td-client.cpp:697
#: ../td-client.cpp:732 ../td-client.cpp:1639 ../td-client.cpp:1765
#: ../td-client.cpp:3925 ../tdlib-purple.cpp:739 ../tdlib-purple.cpp:1778
msgid "_OK"
msgstr "_OK"

#. TRANSLATOR: Dialog option, regarding a phone call; the alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Authentication dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Registration dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Paid reaction dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Message editing dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Forward dialog, alternative is "_Forward". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Message deletion dialog, alternative is "_Delete". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA setup confirmation dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Block dialog, alternative is "_Block". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Report dialog, alternative is "_Next". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Report dialog, alternative is "_Report". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Group creation dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA settings, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#: ../call.cpp:222 ../td-client.cpp:631 ../td-client.cpp:699
#: ../td-client.cpp:734 ../td-client.cpp:1641 ../td-client.cpp:1767
#: ../td-client.cpp:2055 ../td-client.cpp:2269 ../td-client.cpp:3927
#: ../td-client.cpp:4252 ../td-client.cpp:4349 ../td-client.cpp:4370
#: ../tdlib-purple.cpp:741 ../tdlib-purple.cpp:1780
msgid "_Cancel"
msgstr "_Anuluj"

#. TRANSLATOR: In-chat error message
#: ../call.cpp:227
msgid "Received incoming call while already in another call"
msgstr "Odebrano rozmowę przychodzącą w czasie trwania innej rozmowy"

#. TRANSLATOR: In-chat status message. Please keep '/hangup' verbatim!
#: ../call.cpp:238
msgid "Call pending, type /hangup to terminate"
msgstr "Rozmowa jest oczekująca, wpisanie /hangup ją zakończy"

#. TRANSLATOR: In-line reason for an ended call; appears after a colon (':')
#: ../call.cpp:280
msgid "call missed"
msgstr "przegapiono rozmowę"

#. TRANSLATOR: In-line reason for an ended call; appears after a colon (':')
#: ../call.cpp:284
msgid "declined by peer"
msgstr "odrzucona przez partnera"

#. TRANSLATOR: In-line reason for an ended call; appears after a colon (':')
#: ../call.cpp:288
msgid "users disconnected"
msgstr "użytkownik się rozłączył"

#. TRANSLATOR: In-line reason for an ended call; appears after a colon (':')
#: ../call.cpp:292
msgid "hung up"
msgstr "rozłączono"

#. TRANSLATOR: In-line reason for an ended call; appears after a colon (':')
#: ../call.cpp:297
msgid "reason unknown"
msgstr "nieznany powód"

#. TRANSLATOR: In-chat message, arguments will be a duration and a few words (like "hung up")
#: ../call.cpp:301
#, c++-format
msgid "Call ended ({0}): {1}"
msgstr "Zakończono rozmowę ({0}): {1}"

#. TRANSLATOR: In-line error message, appears after a colon (':'), arguments will be a number and some error text from Telegram
#: ../client-utils.cpp:22
#, c++-format
msgid "code {0} ({1})"
msgstr "kod {0} ({1})"

#. TRANSLSATOR: In-line placeholder when an unsupported message is being replied to.
#: ../client-utils.cpp:84
#, c++-format
msgid "Unsupported message type {}"
msgstr "Nieobsługiwany typ wiadomości {}"

#. TRANSLATOR: Buddy-list group, holding channels and groups shown in a conversation though not joined. It lasts until the program quits.
#: ../client-utils.cpp:298
msgid "Telegram: not joined"
msgstr "Telegram: niedołączone"

#. TRANSLATOR: Buddy-list group, holding buddies whose Telegram accounts were deleted.
#: ../client-utils.cpp:430
msgid "Deleted Accounts (Telegram)"
msgstr "Usunięte konta (Telegram)"

#. TRANSLATOR: Buddy's name, of an account that was deleted. The argument is the name it had.
#: ../client-utils.cpp:483
#, c++-format
msgid "{} (deleted)"
msgstr "{} (usunięte)"

#. TRANSLATOR: In-chat status update. The owner may have deleted it, or Telegram.
#: ../client-utils.cpp:488
msgid "This account has been deleted."
msgstr "To konto zostało usunięte."

#. TRANSLATOR: In-chat status update, of an account that had been deleted.
#: ../client-utils.cpp:506
msgid "This account has been restored."
msgstr "To konto zostało przywrócone."

#. TRANSLATOR: The "sender" of a message that was posted to a channel. Will be used like a username.
#: ../client-utils.cpp:787 ../receiving.cpp:674
msgid "Channel post"
msgstr "Wpis kanału"

#. TRANSLATOR: In-chat error message. The arguments are a pasted file's placeholder, such as [report.pdf#3], and where the file was.
#: ../client-utils.cpp:1569
#, c++-format
msgid "The message is not sent: {0} is gone from {1}."
msgstr "Wiadomość nie została wysłana: {0} zniknął z {1}."

#. TRANSLATOR: In-chat error message, argument will be text.
#. TRANSLATOR: In-chat error message, argument will be a user-sent message
#: ../client-utils.cpp:1934 ../td-client.cpp:2759
#, c++-format
msgid "Failed to send message: {}"
msgstr "Wysłanie wiadomości się nie powiodło: {}"

#: ../clipboard.cpp:335
#, c++-format
msgid "xclip failed, with status {}"
msgstr "xclip zakończył się błędem, ze stanem {}"

#. TRANSLATOR: In-line document type. Argument will be a mime type.
#: ../file-transfer.cpp:600
#, c++-format
msgid "voice note [{}]"
msgstr "notatka głosowa [{}]"

#. TRANSLATOR: In-line document type. Argument will be a duration.
#: ../file-transfer.cpp:609
#, c++-format
msgid "video note [{}]"
msgstr "notatka wideo [{}]"

#. TRANSLATOR: Of a video in several sizes, the one as it was sent, in place of a codec, as in "720×576 (original), 14 MiB".
#: ../file-transfer.cpp:623 ../media-variants.cpp:34
msgid "original"
msgstr "oryginał"

#. TRANSLATOR: Filename. Keep it short, and as few special characters as possible.
#: ../file-transfer.cpp:640 ../file-transfer.cpp:642
msgid "voiceNote"
msgstr "NotatkaGłosowa"

#. TRANSLATOR: Filename. Keep it short, and as few special characters as possible.
#: ../file-transfer.cpp:648
msgid "videoNote"
msgstr "NotatkaWideo"

#. TRANSLATOR: Time format. For HH:MM:SS use "{:02}:{:02}:{:02}" without the quotes.
#: ../format.cpp:28
#, c++-format
msgid "{:02}:{:02}:{:02}"
msgstr "{:02}∶{:02}∶{:02}"

#. TRANSLATOR: Info item *and* dialog item.
#: ../purple-info.cpp:23
msgid "Chat ID (don't change):"
msgstr "Identyfikator rozmowy (nie należy zmieniać):"

#. TRANSLATOR: Info item *and* dialog item.
#: ../purple-info.cpp:30
msgid "Join URL or name (empty if creating new):"
msgstr "Adres URL lub nazwa do dołączenia (puste, jeśli tworzone jest nowe):"

#. TRANSLATOR: Info item *and* dialog item.
#: ../purple-info.cpp:37
msgid "Group name (if creating a group):"
msgstr "Nazwa grupy (jeśli tworzona jest grupa):"

#. TRANSLATOR: Info item *and* dialog item.
#: ../purple-info.cpp:44
msgid "Group to create: 1=small 2=big 3=channel"
msgstr "Grupa do utworzenia: 1 = mała, 2 = duża, 3 = kanał"

#. TRANSLATOR: Buddy-window error message, argument will be a "number".
#: ../purple-info.cpp:141
#, c++-format
msgid "Invalid auto-download limit '{}', resetting to default"
msgstr ""
"Nieprawidłowe ograniczenie automatycznego pobierania „{}”, przywracanie "
"domyślnego"

#. TRANSLATOR: Title of a buddy-window error message
#: ../purple-info.cpp:143
msgid "Download limit"
msgstr "Ograniczenie pobierania"

#. TRANSLATOR: In-chat message. Argument is a hyperlink, showing map coordinates.
#: ../receiving.cpp:175
#, c++-format
msgid "Location: {}"
msgstr "Lokalizacja: {}"

#. TRANSLATOR: In-chat message, for a location shared live with no end set. Argument is a hyperlink, showing map coordinates.
#: ../receiving.cpp:178
#, c++-format
msgid "Live location: {}"
msgstr "Lokalizacja na żywo: {}"

#. TRANSLATOR: In-chat message. Arguments are the time (or date and time) the live location will cease to be shared at, and a hyperlink, showing map coordinates.
#: ../receiving.cpp:181
#, c++-format
msgid "Live location until {0}: {1}"
msgstr "Lokalizacja na żywo do {0}: {1}"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to message from 12:00", where it has no text to quote. Also for "photo", "sticker" and the like.
#: ../receiving.cpp:207
msgid "message"
msgstr "wiadomość"

#. TRANSLATOR: File-type, used to describe what is being downloaded, in sentences like "Downloading photo" or "Ignoring photo download".
#: ../receiving.cpp:220 ../receiving.cpp:911 ../receiving.cpp:1265
#: ../receiving.cpp:2058
msgid "photo"
msgstr "zdjęcie"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to document from 12:00".
#: ../receiving.cpp:233
msgid "document"
msgstr "dokument"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to video from 12:00".
#: ../receiving.cpp:242
msgid "video"
msgstr "wideo"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to animation from 12:00".
#: ../receiving.cpp:251
msgid "animation"
msgstr "animacja"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to audio from 12:00".
#: ../receiving.cpp:260
msgid "audio"
msgstr "nagranie audio"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to voice message from 12:00".
#: ../receiving.cpp:269
msgid "voice message"
msgstr "wiadomość głosowa"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to video message from 12:00".
#: ../receiving.cpp:278
msgid "video message"
msgstr "wiadomość wideo"

#. TRANSLATOR: File-type, used to describe what is being downloaded, in sentences like "Downloading photo" or "Ignoring photo download".
#. will not be needed - inline download only
#. TRANSLATOR: File-type, used to describe what is being downloaded, in sentences like "Downloading photo" or "Ignoring photo download".
#: ../receiving.cpp:285 ../receiving.cpp:1325 ../receiving.cpp:2118
msgid "sticker"
msgstr "naklejka"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to location from 12:00".
#: ../receiving.cpp:313
msgid "location"
msgstr "lokalizacja"

#. message == NULL means it could not be fetched, or took too long to fetch
#. TRANSLATOR: In-line placeholder if the original author of a quote is unknown. Is at the beginning of the line if and only if you make it so, see "<b>&bt {} wrote:"...
#. TRANSLATOR: In-chat placeholder for a group member whose name is not known.
#: ../receiving.cpp:678 ../receiving.cpp:1547
msgid "Unknown user"
msgstr "Nieznany użytkownik"

#. TRANSLATOR: In-chat placeholder when something unknown is being replied to.
#: ../receiving.cpp:684
msgid "[message unavailable]"
msgstr "[wiadomość jest niedostępna]"

#. TRANSLATOR: In-line placeholder when a photo is being replied to.
#: ../receiving.cpp:698
msgid "[photo]"
msgstr "[zdjęcie]"

#. TRANSLATOR: In-line placeholder when a file is being replied to. Arguments will be the file name and MIME type (e.g. "application/gzip")
#: ../receiving.cpp:707
#, c++-format
msgid "[file: {0} ({1})]"
msgstr "[plik: {0} ({1})]"

#. TRANSLATOR: In-line placeholder when a video is being replied to. Argument will be the file name.
#: ../receiving.cpp:721
#, c++-format
msgid "[video: {}]"
msgstr "[film: {}]"

#. TRANSLATOR: In-line placeholder when a sticker is being replied to.
#: ../receiving.cpp:732
msgid "[sticker]"
msgstr "[naklejka]"

#. TRANSLATOR: In-line placeholder when a location is being replied to.
#: ../receiving.cpp:748
msgid "[location]"
msgstr "[lokalizacja]"

#. TRANSLATOR: In-chat notification of a reply. Arguments will be username and the original text or description thereof. Please preserve the HTML.
#: ../receiving.cpp:762
#, c++-format
msgid ""
"<b>&gt; {0} wrote:</b>\n"
"&gt; {1}"
msgstr ""
"<b>&gt; Użytkownik {0} napisał:</b>\n"
"&gt; {1}"

#. TRANSLATOR: In-chat notification of forward. Argument will be a username. Please preserve the HTML.
#: ../receiving.cpp:843 ../td-client.cpp:2213
#, c++-format
msgid "<b>Forwarded from {}:</b>"
msgstr "<b>Przekazano od użytkownika {}:</b>"

#. TRANSLATOR: In-chat status update
#: ../receiving.cpp:950
msgid "Converting sticker"
msgstr "Konwertowanie naklejki"

#. TRANSLATOR: Download dialog, primary content, argument will be a username.
#: ../receiving.cpp:1078
#, c++-format
msgid "Download file from {}?"
msgstr "Pobrać plik od użytkownika {}?"

#. TRANSLATOR: Download dialog, placeholder chat title, in the sentence "posted in a private chat".
#: ../receiving.cpp:1084
msgid "a private chat"
msgstr "prywatna rozmowa"

#. TRANSLATOR: Download dialog, secondary content. Arguments will be file description (text), chat name (text), and a file size (text!)
#: ../receiving.cpp:1086
#, c++-format
msgid "{0} posted in {1}, size: {2}"
msgstr "Opublikowano „{0}” w rozmowie „{1}”, rozmiar: {2}"

#. TRANSLATOR: Download dialog, title
#: ../receiving.cpp:1099
msgid "Download"
msgstr "Pobieranie"

#. TRANSLATOR: Download dialog, alternative is "_No"
#. TRANSLATOR: Owning group deletion dialog, alternative is "_No"
#. TRANSLATOR: Group leave dialog, alternative is "_No"
#. TRANSLATOR: Group deletion dialog, alternative is "_No"
#: ../receiving.cpp:1102 ../tdlib-purple.cpp:149 ../tdlib-purple.cpp:159
#: ../tdlib-purple.cpp:191
msgid "_Yes"
msgstr "_Tak"

#. TRANSLATOR: Download dialog, alternative is "_Yes"
#. TRANSLATOR: Owning group deletion dialog, alternative is "_Yes"
#. TRANSLATOR: Group leave dialog, alternative is "_Yes"
#. TRANSLATOR: Group deletion dialog, alternative is "_Yes"
#: ../receiving.cpp:1104 ../tdlib-purple.cpp:151 ../tdlib-purple.cpp:161
#: ../tdlib-purple.cpp:193
msgid "_No"
msgstr "_Nie"

#. TRANSLATOR: In-chat notification, appears after a colon (':'). Argument is a file *type*, not a filename.
#: ../receiving.cpp:1185 ../td-client.cpp:2329
#, c++-format
msgid "Downloading {}"
msgstr "Pobieranie: {}"

#. TRANSLATOR: In-chat notification, appears after a colon (':'). Argument is a file *type*, not a filename.
#: ../receiving.cpp:1190
#, c++-format
msgid "Requesting {} download"
msgstr "Żądanie pobrania: {}"

#. File size above limit, so it's non-zero
#. TRANSLATOR: In-chat notification, appears after a colon (':'). Arguments are a file *type*, not a filename; second argument is a file size with unit.
#: ../receiving.cpp:1195
#, c++-format
msgid "Ignoring {0} download ({1})"
msgstr "Ignorowanie pobierania: {0} ({1})"

#. TRANSLATOR: In-chat notification in a channel. Arguments are the time (or date and time) the message was sent at, as the conversation window shows it, and a hyperlink, showing the map coordinates last shared.
#: ../receiving.cpp:1373
#, c++-format
msgid "The live location from {0} is no longer shared: {1}"
msgstr "Udostępnianie lokalizacji na żywo z wiadomości z {0} zakończono: {1}"

#. TRANSLATOR: In-chat notification. Arguments are a username, the time (or date and time) the message was sent at, as the conversation window shows it, and a hyperlink, showing the map coordinates last shared.
#: ../receiving.cpp:1376
#, c++-format
msgid "{0} stopped sharing the live location from {1}: {2}"
msgstr "{0} przestaje udostępniać lokalizację na żywo z wiadomości z {1}: {2}"

#. TRANSLATOR: In-chat notification in a channel. Argument is the time (or date and time) the message was sent at, as the conversation window shows it.
#: ../receiving.cpp:1381
#, c++-format
msgid "The caption of the message from {0} was removed"
msgstr "Podpis wiadomości z {0} usunięto"

#. TRANSLATOR: In-chat notification. Arguments are a username and the time (or date and time) the message was sent at, as the conversation window shows it.
#: ../receiving.cpp:1384
#, c++-format
msgid "{0} removed the caption of the message from {1}"
msgstr "{0} usuwa podpis wiadomości z {1}"

#. TRANSLATOR: In-chat notification in a channel, not logged, when the message's new text is shown in its place. Argument is the time (or date and time) the message was sent at, as the conversation window shows it.
#: ../receiving.cpp:1397
#, c++-format
msgid "The message from {0} was edited"
msgstr "Wiadomość z {0} edytowano"

#. TRANSLATOR: In-chat notification, not logged, when the message's new text is shown in its place. Arguments are a username and the time (or date and time) the message was sent at, as the conversation window shows it.
#: ../receiving.cpp:1400
#, c++-format
msgid "{0} edited the message from {1}"
msgstr "{0} edytuje wiadomość z {1}"

#. TRANSLATOR: In-chat notification in a channel. Arguments are the time (or date and time) the message was sent at, as the conversation window shows it, and the message's new text.
#: ../receiving.cpp:1408
#, c++-format
msgid "The message from {0} was edited: {1}"
msgstr "Wiadomość z {0} edytowano: {1}"

#. TRANSLATOR: In-chat notification. Arguments are a username, the time (or date and time) the message was sent at, as the conversation window shows it, and the message's new text.
#: ../receiving.cpp:1411
#, c++-format
msgid "{0} edited the message from {1}: {2}"
msgstr "{0} edytuje wiadomość z {1}: {2}"

#. TRANSLATOR: In-chat notification in a channel, followed by the message as edited. Argument is the time (or date and time) the message was sent at, as the conversation window shows it.
#: ../receiving.cpp:1417
#, c++-format
msgid "The message from {0} was edited:"
msgstr "Wiadomość z {0} edytowano:"

#. TRANSLATOR: In-chat notification, followed by the message as edited. Arguments are a username and the time (or date and time) the message was sent at, as the conversation window shows it.
#: ../receiving.cpp:1420
#, c++-format
msgid "{0} edited the message from {1}:"
msgstr "{0} edytuje wiadomość z {1}:"

#. TRANSLATOR: In-chat status update. Argument is a group or channel name.
#: ../receiving.cpp:1569
#, c++-format
msgid "{} was created"
msgstr "Utworzono {}"

#. TRANSLATOR: In-chat status update. Arguments are a user name and a group or channel name.
#: ../receiving.cpp:1571
#, c++-format
msgid "{0} created {1}"
msgstr "{0} tworzy {1}"

#. TRANSLATOR: In-chat status update. Argument is a user name.
#: ../receiving.cpp:1586 ../receiving.cpp:1595
#, c++-format
msgid "{} joined"
msgstr "{} dołącza"

#. TRANSLATOR: In-chat status update. Arguments are a user name and a list of user names.
#: ../receiving.cpp:1588
#, c++-format
msgid "{0} added {1}"
msgstr "{0} dodaje {1}"

#. TRANSLATOR: In-chat status update. Argument is a user name.
#: ../receiving.cpp:1592
#, c++-format
msgid "{} joined by an invite link"
msgstr "{} dołącza przez link z zaproszeniem"

#. TRANSLATOR: In-chat status update. Argument is a user name.
#: ../receiving.cpp:1600
#, c++-format
msgid "{} left"
msgstr "{} wychodzi"

#. TRANSLATOR: In-chat status update. Arguments are user names.
#: ../receiving.cpp:1602
#, c++-format
msgid "{0} removed {1}"
msgstr "{0} usuwa {1}"

#. TRANSLATOR: In-chat status update.
#: ../receiving.cpp:1607
msgid "A message was pinned"
msgstr "Przypięto wiadomość"

#. TRANSLATOR: In-chat status update. Argument is a user name.
#: ../receiving.cpp:1609
#, c++-format
msgid "{} pinned a message"
msgstr "{} przypina wiadomość"

#. TRANSLATOR: After the text of a message edited where it stands, in Pidgin's conversation window, when only the formatting of its words (bold, italic and the like) changed.
#: ../receiving.cpp:1673
msgid "formatting edited"
msgstr "edytowano formatowanie"

#. TRANSLATOR: After the text of a message edited where it stands, in Pidgin's conversation window.
#: ../receiving.cpp:1675
msgid "edited"
msgstr "edytowano"

#. TRANSLATOR: In-chat status update, arguments are chat names.
#: ../receiving.cpp:1723
#, c++-format
msgid "{0} changed group name to {1}"
msgstr "{0} zmienia nazwę grupy na „{1}”"

#. TRANSLATOR: In-chat status update. Argument is a username.
#: ../receiving.cpp:1732
#, c++-format
msgid "{} joined Telegram"
msgstr "{} jest teraz na Telegramie"

#. TRANSLATOR: In-chat message, shown as sent by whoever reacted. Arguments are a reaction (an emoji, mostly) and the beginning of the message's text. Use the quotation marks of your language.
#: ../receiving.cpp:2427
#, c++-format
