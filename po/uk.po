#. TRANSLATOR: Dialog title of an error message.
#. TRANSLATOR: Dialog title, asking about an incoming telephone call (OK/Cancel)
#: ../call.cpp:29 ../call.cpp:216
msgid "Voice call"
msgstr "Голосовий дзвінок"

#. TRANSLATOR: Dialog content of an error message.
#: ../call.cpp:31
msgid "Cannot start new call, already in another call"
msgstr "Неможливо почати новий дзвінок: уже триває інший"

#. For an outgoing call, "type /hangup to terminate" has already been shown when the call
#. was initiated
#. TRANSLATOR: In-chat status message
#: ../call.cpp:139
msgid "Call active"
msgstr "Дзвінок триває"

#. TRANSLATOR: In-chat status message. Please keep '/hangup' verbatim!
#: ../call.cpp:141
msgid "Call active, type /hangup to terminate"
msgstr "Дзвінок триває; щоб завершити, введіть /hangup"

#. TRANSLATOR: In-chat error message, argument is text
#: ../call.cpp:170
#, c++-format
msgid "Call failed: {}"
msgstr "Дзвінок не вдався: {}"

#. TRANSLATOR: In-chat error message
#: ../call.cpp:194
msgid "Received incoming call, but calls are not supported"
msgstr "Надійшов вхідний дзвінок, але дзвінки не підтримуються"

#. TRANSLATOR: Dialog content, user will have the options "_OK" and "_Cancel".
#: ../call.cpp:208
#, c++-format
msgid "{} wishes to start a call with you."
msgstr "{} хоче вам зателефонувати."

#. TRANSLATOR: Dialog option, regarding a phone call; the alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Authentication dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Registration dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA setup confirmation dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Group creation dialog, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA settings, alternative is "_Cancel". The underscore marks accelerator keys, they must be different!
#: ../call.cpp:220 ../td-client.cpp:516 ../td-client.cpp:580
#: ../td-client.cpp:611 ../td-client.cpp:2153 ../tdlib-purple.cpp:521
#: ../tdlib-purple.cpp:1145
msgid "_OK"
msgstr "_Гаразд"

#. TRANSLATOR: Dialog option, regarding a phone call; the alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Authentication dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Registration dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA setup confirmation dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: Group creation dialog, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#. TRANSLATOR: 2FA settings, alternative is "_OK". The underscore marks accelerator keys, they must be different!
#: ../call.cpp:222 ../td-client.cpp:518 ../td-client.cpp:582
#: ../td-client.cpp:613 ../td-client.cpp:2155 ../tdlib-purple.cpp:523
#: ../tdlib-purple.cpp:1147
msgid "_Cancel"
msgstr "_Скасувати"

#. TRANSLATOR: In-chat error message
#: ../call.cpp:227
msgid "Received incoming call while already in another call"
msgstr "Надійшов вхідний дзвінок під час іншого дзвінка"

#. TRANSLATOR: In-chat status message. Please keep '/hangup' verbatim!
#: ../call.cpp:238
msgid "Call pending, type /hangup to terminate"
msgstr "Дзвінок очікує відповіді; щоб завершити, введіть /hangup"

#. TRANSLATOR: In-line reason for an ended call; appears after a colon (':')
#: ../call.cpp:280
msgid "call missed"
msgstr "пропущений дзвінок"

#. TRANSLATOR: In-line reason for an ended call; appears after a colon (':')
#: ../call.cpp:284
msgid "declined by peer"
msgstr "відхилено співрозмовником"

#. TRANSLATOR: In-line reason for an ended call; appears after a colon (':')
#: ../call.cpp:288
msgid "users disconnected"
msgstr "з'єднання розірвано"

#. TRANSLATOR: In-line reason for an ended call; appears after a colon (':')
#: ../call.cpp:292
msgid "hung up"
msgstr "слухавку покладено"

#. TRANSLATOR: In-line reason for an ended call; appears after a colon (':')
#: ../call.cpp:297
msgid "reason unknown"
msgstr "причина невідома"

#. TRANSLATOR: In-chat message, arguments will be a duration and a few words (like "hung up")
#: ../call.cpp:301
#, c++-format
msgid "Call ended ({0}): {1}"
msgstr "Дзвінок завершено ({0}): {1}"

#. TRANSLATOR: In-line error message, appears after a colon (':'), arguments will be a number and some error text from Telegram
#: ../client-utils.cpp:21
#, c++-format
msgid "code {0} ({1})"
msgstr "код {0} ({1})"

#. TRANSLSATOR: In-line placeholder when an unsupported message is being replied to.
#: ../client-utils.cpp:83
#, c++-format
msgid "Unsupported message type {}"
msgstr "Непідтримуваний тип повідомлення {}"

#. TRANSLATOR: In-chat status update
#: ../client-utils.cpp:357
msgid "Future messages in this conversation will be shown in a different tab"
msgstr "Подальші повідомлення цієї розмови буде показано в іншій вкладці"

#. TRANSLATOR: The "sender" of a message that was posted to a channel. Will be used like a username.
#: ../client-utils.cpp:559
msgid "Channel post"
msgstr "Допис каналу"

#. TRANSLATOR: In-chat error message, argument will be text.
#. TRANSLATOR: In-chat error message, argument will be a user-sent message
#: ../client-utils.cpp:931 ../td-client.cpp:1108
#, c++-format
msgid "Failed to send message: {}"
msgstr "Не вдалося надіслати повідомлення: {}"

#. TRANSLATOR: In-line document type. Argument will be a mime type.
#: ../file-transfer.cpp:578
#, c++-format
msgid "voice note [{}]"
msgstr "голосове повідомлення [{}]"

#. TRANSLATOR: In-line document type. Argument will be a duration.
#: ../file-transfer.cpp:587
#, c++-format
msgid "video note [{}]"
msgstr "відеоповідомлення [{}]"

# Kept in ASCII: it becomes part of a file name
#. TRANSLATOR: Filename. Keep it short, and as few special characters as possible.
#: ../file-transfer.cpp:595 ../file-transfer.cpp:597
msgid "voiceNote"
msgstr "voiceNote"

# Kept in ASCII: it becomes part of a file name
#. TRANSLATOR: Filename. Keep it short, and as few special characters as possible.
#: ../file-transfer.cpp:603
msgid "videoNote"
msgstr "videoNote"

#. TRANSLATOR: Time format. For HH:MM:SS use "{:02}:{:02}:{:02}" without the quotes.
#: ../format.cpp:28
#, c++-format
msgid "{:02}:{:02}:{:02}"
msgstr "{:02}:{:02}:{:02}"

#. TRANSLATOR: Info item *and* dialog item.
#: ../purple-info.cpp:23
msgid "Chat ID (don't change):"
msgstr "Ідентифікатор розмови (не змінюйте):"

#. TRANSLATOR: Info item *and* dialog item.
#: ../purple-info.cpp:30
msgid "Join URL or name (empty if creating new):"
msgstr "Посилання для приєднання або назва (порожньо, якщо створюєте нову):"

#. TRANSLATOR: Info item *and* dialog item.
#: ../purple-info.cpp:37
msgid "Group name (if creating a group):"
msgstr "Назва групи (якщо створюєте групу):"

#. TRANSLATOR: Info item *and* dialog item.
#: ../purple-info.cpp:44
msgid "Group to create: 1=small 2=big 3=channel"
msgstr "Що створити: 1=малу групу 2=велику групу 3=канал"

#. TRANSLATOR: Buddy-window error message, argument will be a "number".
#: ../purple-info.cpp:113
#, c++-format
msgid "Invalid auto-download limit '{}', resetting to default"
msgstr "Неприпустиме обмеження автозавантаження «{}», відновлено типове"

#. TRANSLATOR: Title of a buddy-window error message
#: ../purple-info.cpp:115
msgid "Download limit"
msgstr "Обмеження завантаження"

#. TRANSLATOR: In-chat message. Argument is a hyperlink, showing map coordinates.
#: ../receiving.cpp:168
#, c++-format
msgid "Location: {}"
msgstr "Геопозиція: {}"

#. TRANSLATOR: In-chat message, for a location shared live with no end set. Argument is a hyperlink, showing map coordinates.
#: ../receiving.cpp:171
#, c++-format
msgid "Live location: {}"
msgstr "Трансляція геопозиції: {}"

#. TRANSLATOR: In-chat message. Arguments are the time (or date and time) the live location will cease to be shared at, and a hyperlink, showing map coordinates.
#: ../receiving.cpp:174
#, c++-format
msgid "Live location until {0}: {1}"
msgstr "Трансляція геопозиції до {0}: {1}"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to message from 12:00", where it has no text to quote. Also for "photo", "sticker" and the like.
#: ../receiving.cpp:190
msgid "message"
msgstr "повідомлення"

#. TRANSLATOR: File-type, used to describe what is being downloaded, in sentences like "Downloading photo" or "Ignoring photo download".
#: ../receiving.cpp:201 ../receiving.cpp:919 ../receiving.cpp:1389
msgid "photo"
msgstr "фото"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to document from 12:00".
#: ../receiving.cpp:214
msgid "document"
msgstr "документ"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to video from 12:00".
#: ../receiving.cpp:223
msgid "video"
msgstr "відео"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to animation from 12:00".
#: ../receiving.cpp:232
msgid "animation"
msgstr "анімація"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to audio from 12:00".
#: ../receiving.cpp:241
msgid "audio"
msgstr "аудіо"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to voice message from 12:00".
#: ../receiving.cpp:250
msgid "voice message"
msgstr "голосове повідомлення"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to video message from 12:00".
#: ../receiving.cpp:259
msgid "video message"
msgstr "відеоповідомлення"

#. TRANSLATOR: File-type, used to describe what is being downloaded, in sentences like "Downloading photo" or "Ignoring photo download".
#. will not be needed - inline download only
#. TRANSLATOR: File-type, used to describe what is being downloaded, in sentences like "Downloading photo" or "Ignoring photo download".
#: ../receiving.cpp:266 ../receiving.cpp:979 ../receiving.cpp:1448
msgid "sticker"
msgstr "наліпка"

#. TRANSLATOR: What a message is, as in "reacted with 👍 to location from 12:00".
#: ../receiving.cpp:293
msgid "location"
msgstr "геопозиція"

#. message == NULL means it could not be fetched, or took too long to fetch
#. TRANSLATOR: In-line placeholder if the original author of a quote is unknown. Is at the beginning of the line if and only if you make it so, see "<b>&bt {} wrote:"...
#: ../receiving.cpp:465
msgid "Unknown user"
msgstr "Невідомий користувач"

#. TRANSLATOR: In-chat placeholder when something unknown is being replied to.
#: ../receiving.cpp:471
msgid "[message unavailable]"
msgstr "[повідомлення недоступне]"

#. TRANSLATOR: In-line placeholder when a photo is being replied to.
#: ../receiving.cpp:484
msgid "[photo]"
msgstr "[фото]"

#. TRANSLATOR: In-line placeholder when a file is being replied to. Arguments will be the file name and MIME type (e.g. "application/gzip")
#: ../receiving.cpp:493
#, c++-format
msgid "[file: {0} ({1})]"
msgstr "[файл: {0} ({1})]"

#. TRANSLATOR: In-line placeholder when a video is being replied to. Argument will be the file name.
#: ../receiving.cpp:507
#, c++-format
msgid "[video: {}]"
msgstr "[відео: {}]"

#. TRANSLATOR: In-line placeholder when a sticker is being replied to.
#: ../receiving.cpp:518
msgid "[sticker]"
msgstr "[наліпка]"

#. TRANSLATOR: In-line placeholder when a location is being replied to.
#: ../receiving.cpp:534
msgid "[location]"
msgstr "[геопозиція]"

# Present tense, as Ukrainian quote headers have it, and as it avoids choosing a gender
#. TRANSLATOR: In-chat notification of a reply. Arguments will be username and the original text or description thereof. Please preserve the HTML.
#: ../receiving.cpp:548
#, c++-format
msgid ""
"<b>&gt; {0} wrote:</b>\n"
"&gt; {1}"
msgstr ""
"<b>&gt; {0} пише:</b>\n"
"&gt; {1}"

#. TRANSLATOR: In-chat notification of forward. Argument will be a username. Please preserve the HTML.
#: ../receiving.cpp:568
#, c++-format
msgid "<b>Forwarded from {}:</b>"
msgstr "<b>Переслано від {}:</b>"

#. TRANSLATOR: In-chat status update
#: ../receiving.cpp:666
msgid "Converting sticker"
msgstr "Перетворення наліпки"

#. TRANSLATOR: Download dialog, primary content, argument will be a username.
#: ../receiving.cpp:773
#, c++-format
msgid "Download file from {}?"
msgstr "Завантажити файл від {}?"

# Follows "в" in "{0} — надіслано в {1}", hence the locative
#. TRANSLATOR: Download dialog, placeholder chat title, in the sentence "posted in a private chat".
#: ../receiving.cpp:779
msgid "a private chat"
msgstr "особистій розмові"

#. TRANSLATOR: Download dialog, secondary content. Arguments will be file description (text), chat name (text), and a file size (text!)
#: ../receiving.cpp:781
#, c++-format
msgid "{0} posted in {1}, size: {2}"
msgstr "{0} — надіслано в {1}, розмір: {2}"

#. TRANSLATOR: Download dialog, title
#: ../receiving.cpp:794
msgid "Download"
msgstr "Завантаження"

#. TRANSLATOR: Download dialog, alternative is "_No"
#. TRANSLATOR: Owning group deletion dialog, alternative is "_No"
#. TRANSLATOR: Group leave dialog, alternative is "_No"
#. TRANSLATOR: Group deletion dialog, alternative is "_No"
#: ../receiving.cpp:797 ../tdlib-purple.cpp:142 ../tdlib-purple.cpp:152
#: ../tdlib-purple.cpp:184
msgid "_Yes"
msgstr "_Так"

#. TRANSLATOR: Download dialog, alternative is "_Yes"
#. TRANSLATOR: Owning group deletion dialog, alternative is "_Yes"
#. TRANSLATOR: Group leave dialog, alternative is "_Yes"
#. TRANSLATOR: Group deletion dialog, alternative is "_Yes"
#: ../receiving.cpp:799 ../tdlib-purple.cpp:144 ../tdlib-purple.cpp:154
#: ../tdlib-purple.cpp:186
msgid "_No"
msgstr "_Ні"

#. TRANSLATOR: In-chat notification, appears after a colon (':'). Argument is a file *type*, not a filename.
#: ../receiving.cpp:843
#, c++-format
msgid "Downloading {}"
msgstr "Завантаження: {}"

#. TRANSLATOR: In-chat notification, appears after a colon (':'). Argument is a file *type*, not a filename.
#: ../receiving.cpp:848
#, c++-format
msgid "Requesting {} download"
msgstr "Запит на завантаження: {}"

#. File size above limit, so it's non-zero
#. TRANSLATOR: In-chat notification, appears after a colon (':'). Arguments are a file *type*, not a filename; second argument is a file size with unit.
#: ../receiving.cpp:853
#, c++-format
msgid "Ignoring {0} download ({1})"
msgstr "Завантаження пропущено: {0} ({1})"

#. TRANSLATOR: In-chat notification. Arguments are a username, the time (or date and time) the message was sent at, as the conversation window shows it, and a hyperlink, showing the map coordinates last shared.
#: ../receiving.cpp:1020
#, c++-format
msgid "{0} stopped sharing the live location from {1}: {2}"
msgstr "{0} припиняє трансляцію геопозиції з повідомлення від {1}: {2}"

#. TRANSLATOR: In-chat notification. Arguments are a username and the time (or date and time) the message was sent at, as the conversation window shows it.
#: ../receiving.cpp:1024
#, c++-format
msgid "{0} removed the caption of the message from {1}"
msgstr "{0} прибирає підпис повідомлення від {1}"

#. TRANSLATOR: In-chat notification. Arguments are a username, the time (or date and time) the message was sent at, as the conversation window shows it, and the message's new text.
#: ../receiving.cpp:1032
#, c++-format
msgid "{0} edited the message from {1}: {2}"
msgstr "{0} редагує повідомлення від {1}: {2}"

#. TRANSLATOR: In-chat notification, followed by the message as edited. Arguments are a username and the time (or date and time) the message was sent at, as the conversation window shows it.
#: ../receiving.cpp:1035
#, c++-format
msgid "{0} edited the message from {1}:"
msgstr "{0} редагує повідомлення від {1}:"

#. TRANSLATOR: In-chat status update, arguments are chat names.
#: ../receiving.cpp:1127
#, c++-format
msgid "{0} changed group name to {1}"
msgstr "{0} змінює назву групи на «{1}»"

#. TRANSLATOR: In-chat reaction, in place of one that is a picture of its own rather than an emoji, as in "reacted with [custom emoji] to message ...".
#: ../receiving.cpp:1682
msgid "[custom emoji]"
msgstr "[власне емодзі]"

#. TRANSLATOR: In-chat message, shown as sent by whoever reacted. Arguments are a reaction (an emoji, mostly) and the beginning of the message's text. Use the quotation marks of your language.
#: ../receiving.cpp:1729
#, c++-format
msgid "reacted with {0} to message „{1}“."
msgstr "реагує {0} на повідомлення „{1}“."

#. TRANSLATOR: In-chat message, shown as sent by whoever reacted. Arguments are a reaction (an emoji, mostly), what the message is ("photo", "sticker" and the like), and the time (or date and time) it was sent at, as the conversation window shows it.
#: ../receiving.cpp:1732
#, c++-format
msgid "reacted with {0} to {1} from {2}."
msgstr "реагує {0} на: {1} від {2}."

#. TRANSLATOR: In-chat message, shown as sent by whoever reacted. Argument is the beginning of the message's text. Use the quotation marks of your language.
#: ../receiving.cpp:1736
#, c++-format
msgid "removed their reaction to message „{0}“."
msgstr "скасовує свою реакцію на повідомлення „{0}“."

#. TRANSLATOR: In-chat message, shown as sent by whoever reacted. Arguments are what the message is ("photo", "sticker" and the like), and the time (or date and time) it was sent at, as the conversation window shows it.
#: ../receiving.cpp:1739
#, c++-format
msgid "removed their reaction to {0} from {1}."
msgstr "скасовує свою реакцію на: {0} від {1}."

#. TRANSLATOR: In-chat notification. Argument is the time (or date and time) the message was sent at, as the conversation window shows it.
#: ../receiving.cpp:1894
#, c++-format
msgid "Message from {} has been deleted"
msgstr "Повідомлення від {} видалено"

#: ../receiving.cpp:1942
#, c++-format
msgid "Failed to fetch earlier messages: {}"
msgstr "Не вдалося отримати попередні повідомлення: {}"

#. TRANSLATOR: Default buddy-alias for a new secret chat. Argument is the Telegram nick, I think.
#: ../secret-chat.cpp:20
#, c++-format
msgid "Secret chat: {}"
msgstr "Секретна розмова: {}"

#. TRANSLATOR: In-chat message to explain why the chat is not established yet.
#: ../secret-chat.cpp:51
msgid "The secret chat will be available when activated by the peer"
msgstr "Секретна розмова стане доступною, щойно співрозмовник її активує"

#. TRANSLATOR: Buddy-window error message, argument will be some kind of proxy-identifier.
#: ../td-client.cpp:359
#, c++-format
msgid "Proxy type {} is not supported"
msgstr "Тип проксі {} не підтримується"

#. TRANSLATOR: Buddy-window error message
#: ../td-client.cpp:391
#, c++-format
msgid "Could not set proxy: {}"
msgstr "Не вдалося налаштувати проксі: {}"

#. TRANSLATOR: Buddy-window error message
#: ../td-client.cpp:404
#, c++-format
msgid "Could not get proxies: {}"
msgstr "Не вдалося отримати список проксі: {}"

#. TRANSLATOR: Authentication dialog, secondary content. Appears after a colon (':'). Argument is a number.
#: ../td-client.cpp:470
#, c++-format
msgid "Telegram message (length: {})"
msgstr "Повідомлення в Telegram (довжина: {})"

#. TRANSLATOR: Authentication dialog, secondary content. Appears after a colon (':'). Argument is a number.
#: ../td-client.cpp:474
#, c++-format
msgid "SMS (length: {})"
msgstr "SMS (довжина: {})"

#. TRANSLATOR: Authentication dialog, secondary content. Appears after a colon (':'). Argument is a number.
#: ../td-client.cpp:478
#, c++-format
msgid "Phone call (length: {})"
msgstr "Телефонний дзвінок (довжина: {})"

#. TRANSLATOR: Authentication dialog, secondary content. Official name "flash call". Appears after a colon (':'). Argument is some text-string-ish.
#: ../td-client.cpp:482
#, c++-format
msgid "Poor man's phone call (pattern: {})"
msgstr "Флеш-дзвінок (шаблон: {})"

#. TRANSLATOR: Authentication dialog, primary content. Will be followed by instructions and an input box.
#: ../td-client.cpp:493
msgid "Enter authentication code"
msgstr "Введіть код автентифікації"

#. TRANSLATOR: Authentication dialog, secondary content. Argument will be a term.
#: ../td-client.cpp:498
#, c++-format
msgid "Code sent via: {}"
msgstr "Код надіслано через: {}"

#. TRANSLATOR: Authentication dialog, secondary content. Argument will be a term.
#: ../td-client.cpp:502
#, c++-format
msgid "Next code will be: {}"
msgstr "Наступний код надійде через: {}"

#. TRANSLATOR: Authentication dialog, title.
#: ../td-client.cpp:508
msgid "Login code"
msgstr "Код входу"

#. TRANSLATOR: Connection failure, error message (title; empty content)
#: ../td-client.cpp:538
msgid "Authentication code required"
msgstr "Потрібен код автентифікації"

#. TRANSLATOR: Connection failure, error message title (title; empty content)
#: ../td-client.cpp:553
msgid "Password required"
msgstr "Потрібен пароль"

#. TRANSLATOR: 2FA dialog, secondary content, appears in new line. Argument is an arbitrary string from Telegram.
#: ../td-client.cpp:561
#, c++-format
msgid "Hint: {}"
msgstr "Підказка: {}"

#. TRANSLATOR: 2FA dialog, secondary content, appears in new line. Argument is an e-mail address.
#: ../td-client.cpp:567
#, c++-format
msgid "Recovery e-mail may have been sent to {}"
msgstr "Можливо, лист для відновлення надіслано на {}"

#. TRANSLATOR: 2FA dialog, title
#: ../td-client.cpp:571
msgid "Password"
msgstr "Пароль"

#. TRANSLATOR: 2FA dialog, primary content
#: ../td-client.cpp:573
msgid "Enter password for two-factor authentication"
msgstr "Введіть пароль двофакторної автентифікації"

#. TRANSLATOR: Registration dialog, title
#: ../td-client.cpp:602
msgid "Registration"
msgstr "Реєстрація"

#. TRANSLATOR: Registration dialog, content
#: ../td-client.cpp:604
msgid "New account is being created. Please enter your display name."
